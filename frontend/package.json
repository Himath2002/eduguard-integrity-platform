{
  "name": "eduguard-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Role-aware academic integrity workflows for students, lecturers, and administrators.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
