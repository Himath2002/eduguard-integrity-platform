{
  "name": "eduguard-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Role-aware academic integrity workflows for students, lecturers, and administrators.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
