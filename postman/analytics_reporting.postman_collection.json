{
  "info": {
    "_postman_id": "233c8131-d0bf-45db-92c2-f02da173ce40",
    "name": "EduGuard Analytics and Reporting",
    "description": "Newman/Postman regression collection for analytics dashboard summaries and reporting endpoints. Updated to fail fast when DB-backed endpoints return 503, preventing cascading assertion failures.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === '00 - Health check / API availability') {",
          "  const existingRunId = pm.variables.get('runId');",
          "  const runId = existingRunId && String(existingRunId).trim() ? String(existingRunId).trim() : String(Date.now()).slice(-10);",
          "  const lecturerIdent = pm.variables.get('lecturerIdent') || `arlect${runId}`;",
          "  const studentIdent = pm.variables.get('studentIdent') || `arstud${runId}`;",
          "  pm.collectionVariables.set('runId', runId);",
          "  pm.collectionVariables.set('lecturerIdent', lecturerIdent);",
          "  pm.collectionVariables.set('studentIdent', studentIdent);",
          "  pm.collectionVariables.set('lecturerEmail', pm.variables.get('lecturerEmail') || `${lecturerIdent}@example.com`);",
          "  pm.collectionVariables.set('studentEmail', pm.variables.get('studentEmail') || `${studentIdent}@example.com`);",
          "  pm.collectionVariables.set('classCode', pm.variables.get('classCode') || `POSTAR${runId}`);",
          "  pm.collectionVariables.set('classId', pm.variables.get('classId') || '');",
          "  pm.collectionVariables.set('assignmentId', pm.variables.get('assignmentId') || '');",
          "  pm.collectionVariables.set('missingSubmissionId', pm.variables.get('missingSubmissionId') || '999999');",
          "  pm.collectionVariables.set('testPassword', pm.variables.get('testPassword') || 'Password123!');",
          "  pm.collectionVariables.set('dbReady', pm.variables.get('dbReady') || 'unknown');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "lecturerIdent",
      "value": ""
    },
    {
      "key": "studentIdent",
      "value": ""
    },
    {
      "key": "lecturerEmail",
      "value": ""
    },
    {
      "key": "studentEmail",
      "value": ""
    },
    {
      "key": "classCode",
      "value": ""
    },
    {
      "key": "classId",
      "value": ""
    },
    {
      "key": "assignmentId",
      "value": ""
    },
    {
      "key": "missingSubmissionId",
      "value": "999999"
    },
    {
      "key": "testPassword",
      "value": "Password123!"
