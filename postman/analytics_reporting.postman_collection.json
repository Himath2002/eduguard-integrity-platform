              "if (pm.response.code !== 200) {",
              "  pm.test('student marked reports list returns 200', function () { pm.response.to.have.status(200); });",
              "} else {",
              "  pm.test('student marked reports list returns 200', function () { pm.response.to.have.status(200); });",
              "  pm.test('student marked reports list is an array scoped by class code', function () {",
              "    const classCode = pm.collectionVariables.get('classCode');",
              "    pm.expect(json).to.be.an('array');",
              "    json.forEach(function (row) {",
              "      pm.expect(row.class_code).to.eql(classCode);",
              "      pm.expect(row).to.have.property('submission_id');",
              "      pm.expect(row).to.have.property('assignment_title');",
              "      pm.expect(row).to.have.property('score');",
              "      pm.expect(row).to.have.property('max_score');",
              "    });",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
