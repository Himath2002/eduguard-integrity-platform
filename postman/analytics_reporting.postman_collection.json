  "item": [
    {
      "name": "00 - Health check / API availability",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('backend health endpoint is available', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('health response is a JSON object', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.be.an('object');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "00.1 - Database readiness check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/dashboard/summary"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function readJson() {",
              "  try { return pm.response.json(); } catch (e) { return {}; }",
              "}",
              "const json = readJson();",
              "",
              "if (pm.response.code === 503) {",
              "  pm.collectionVariables.set('dbReady', 'false');",
              "  pm.test('database unavailable - DB-backed regression requests skipped', function () {",
              "    pm.expect(pm.response.code).to.eql(503);",
              "    pm.expect(String(json.detail || '')).to.match(/Database connection is unavailable|database/i);",
              "  });",
              "  console.warn('Skipping Analytics and Reporting DB-backed regression tests because the backend returned 503. Start PostgreSQL/SSH tunnel and rerun for full regression coverage.');",
              "  pm.execution.setNextRequest(null);",
              "} else {",
              "  pm.collectionVariables.set('dbReady', 'true');",
              "  pm.test('database is available for regression tests', function () {",
              "    pm.response.to.have.status(200);",
              "  });",
              "  pm.test('database readiness response is JSON object', function () {",
              "    pm.expect(json).to.be.an('object');",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Setup lecturer user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/signup",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Postman Analytics Lecturer\",\n  \"username\": \"{{lecturerIdent}}\",\n  \"email\": \"{{lecturerEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"lecturer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function readJson() {",
              "  try { return pm.response.json(); } catch (e) { return {}; }",
              "}",
              "function stopBecause(message) {",
              "  console.error(message);",
              "  postman.setNextRequest(null);",
              "}",
              "const json = readJson();",
              "if (pm.response.code !== 200) {",
              "  pm.test('lecturer test user created', function () { pm.response.to.have.status(200); });",
              "  stopBecause('Stopping collection: lecturer setup failed. ' + (json.detail || pm.response.text()));",
              "} else {",
              "  pm.test('lecturer test user created', function () {",
              "    pm.expect(json.role).to.eql('lecturer');",
              "    pm.expect(json.username).to.eql(pm.collectionVariables.get('lecturerIdent'));",
              "    pm.expect(json.userId).to.exist;",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
