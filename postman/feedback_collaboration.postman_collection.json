    {
      "name": "14 - Confirm created announcement can be searched",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/communications/admin/{{adminIdent}}/announcements?search={{createdAnnouncementSubject}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "communications",
            "admin",
            "{{adminIdent}}",
            "announcements"
          ],
          "query": [
            {
              "key": "search",
              "value": "{{createdAnnouncementSubject}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "const detail = json && json.detail;",
              "if (pm.response.code === 503) {",
              "  pm.collectionVariables.set('dbAvailable', 'false');",
              "}",
              "",
              "pm.test('confirm announcement search status is valid for the current environment', function () {",
              "  pm.expect([200, 503]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test('created announcement is searchable when it was created, otherwise the API still responds with a safe contract', function () {",
              "  const announcementCreated = pm.collectionVariables.get('announcementCreated') === 'true';",
              "  if (pm.response.code === 503) {",
              "    pm.expect(json).to.be.an('object');",
              "    pm.expect(detail).to.exist;",
              "    pm.expect(String(detail).toLowerCase()).to.include('database');",
              "  } else if (announcementCreated) {",
              "    pm.expect(json).to.be.an('array');",
              "    const expected = pm.collectionVariables.get('createdAnnouncementSubject');",
              "    const found = json.some(item => item && item.subject === expected);",
              "    pm.expect(found).to.eql(true);",
              "  } else {",
              "    pm.expect(json).to.be.an('array');",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
