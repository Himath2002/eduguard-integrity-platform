      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/communications/admin/{{adminIdent}}/announcements",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject\": \"{{createdAnnouncementSubject}}\",\n  \"body\": \"This announcement was created by the feedback and collaboration Newman regression test.\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "const detail = json && json.detail;",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('dbAvailable', 'true');",
              "  pm.collectionVariables.set('announcementCreated', 'true');",
              "} else if (pm.response.code === 503) {",
              "  pm.collectionVariables.set('dbAvailable', 'false');",
              "  pm.collectionVariables.set('announcementCreated', 'false');",
              "}",
              "",
              "pm.test('create admin announcement status is valid for the current environment', function () {",
              "  pm.expect([200, 503]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test('create admin announcement returns success contract when DB is available, otherwise a safe DB-unavailable error', function () {",
              "  if (pm.response.code === 200) {",
              "    pm.expect(json).to.be.an('object');",
              "    pm.expect(json.ok).to.eql(true);",
              "    pm.expect(json.announcement).to.be.an('object');",
              "    pm.expect(json.announcement.subject).to.eql(pm.collectionVariables.get('createdAnnouncementSubject'));",
              "  } else {",
              "    pm.expect(json).to.be.an('object');",
              "    pm.expect(detail).to.exist;",
              "    pm.expect(String(detail).toLowerCase()).to.include('database');",
              "  }",
              "});"
            ]
          }
        }
