{
  "info": {
    "name": "EduGuard Feedback and Collaboration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Newman/Postman regression collection for the Feedback and Collaboration backend. It validates backend health, user setup, lecturer/student thread list APIs, safe error handling, announcement APIs, and standard response envelopes. The collection automatically handles the case where the backend is running but the database connection is unavailable and treats those DB-unavailable responses as a valid regression path instead of hard failures."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "lecturerIdent",
      "value": ""
    },
    {
      "key": "studentIdent",
      "value": ""
    },
    {
      "key": "adminIdent",
      "value": ""
    },
    {
      "key": "lecturerEmail",
      "value": ""
    },
    {
      "key": "studentEmail",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": "Password123!"
    },
    {
      "key": "createdAnnouncementSubject",
      "value": ""
    },
    {
      "key": "dbAvailable",
      "value": "unknown"
    },
    {
      "key": "announcementCreated",
      "value": "false"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === '00 - Health check / API availability') {",
          "  const runId = String(Date.now()).slice(-10);",
          "  const lecturerIdent = `fclect${runId}`;",
          "  const studentIdent = `fcstud${runId}`;",
          "  const adminIdent = `fcadmin${runId}`;",
          "  pm.collectionVariables.set('runId', runId);",
          "  pm.collectionVariables.set('lecturerIdent', lecturerIdent);",
          "  pm.collectionVariables.set('studentIdent', studentIdent);",
          "  pm.collectionVariables.set('adminIdent', adminIdent);",
          "  pm.collectionVariables.set('lecturerEmail', `${lecturerIdent}@example.com`);",
          "  pm.collectionVariables.set('studentEmail', `${studentIdent}@example.com`);",
          "  pm.collectionVariables.set('adminEmail', `${adminIdent}@example.com`);",
          "  pm.collectionVariables.set('testPassword', pm.collectionVariables.get('testPassword') || 'Password123!');",
          "  pm.collectionVariables.set('createdAnnouncementSubject', `Feedback collaboration announcement ${runId}`);",
          "  pm.collectionVariables.set('dbAvailable', 'unknown');",
          "  pm.collectionVariables.set('announcementCreated', 'false');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Health check / API availability",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('backend health endpoint is available', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('health response is JSON object', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.be.an('object');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Setup lecturer user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/signup",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Feedback Collaboration Lecturer\",\n  \"username\": \"{{lecturerIdent}}\",\n  \"email\": \"{{lecturerEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"lecturer\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "const detail = json && json.detail;",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('dbAvailable', 'true');",
              "} else if (pm.response.code === 503) {",
              "  pm.collectionVariables.set('dbAvailable', 'false');",
              "}",
              "",
              "pm.test('01 - setup lecturer user status is valid for current environment', function () {",
              "  pm.expect([200, 503]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test('01 - setup lecturer user returns either the expected user contract or a safe DB-unavailable error', function () {",
              "  if (pm.response.code === 200) {",
              "    pm.expect(json.username).to.eql(pm.collectionVariables.get('lecturerIdent'));",
              "    pm.expect(json.role).to.eql('lecturer');",
              "  } else {",
              "    pm.expect(json).to.be.an('object');",
              "    pm.expect(detail).to.exist;",
              "    pm.expect(String(detail).toLowerCase()).to.include('database');",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
