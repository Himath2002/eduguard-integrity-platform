DATABASE_URL=postgresql+psycopg2://eduguard_user:change-me@127.0.0.1:5432/eduguard
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_SIGNUP_SECRET=replace-with-a-long-random-value
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10

# Optional: absolute root for local PDFs stored outside backend/uploads.
EDUGUARD_LOCAL_STORAGE_ROOT=

# --- AI (Option-2: Multi-signal risk scoring; fine-tune later) ---
ENABLE_AI_DETECTION=1
AI_THRESHOLD_PERCENT=60
AI_LEVEL_MEDIUM_AT=40
AI_LEVEL_HIGH_AT=70
AI_RISK_MIN_WORDS=80
AI_RISK_SPAN_THRESHOLD_PERCENT=60
AI_RISK_MAX_SPANS=8
AI_RISK_W_BURSTINESS=0.25
AI_RISK_W_REPETITION2=0.25
AI_RISK_W_REPETITION3=0.15
AI_RISK_W_COHERENCE=0.15
AI_RISK_W_LEXICAL=0.20

# Optional (heavy)
AI_ENABLE_PERPLEXITY=0
AI_PERPLEXITY_MODEL=distilgpt2

# Optional model-assisted detector (disabled by default)
ENABLE_AI_MODEL_DETECTION=0
AI_DETECTOR_MODEL_NAME=roberta-base
AI_POSITIVE_LABEL=
HF_DEVICE=-1


# --- AWS S3 storage ---
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-eduguard-bucket

# --- Optional asynchronous worker ---
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0
